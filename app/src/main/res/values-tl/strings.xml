    <!-- User guide screen -->
    <string name="user_guide_title">Gabay ng Gumagamit</string>
    <string name="user_guide_heading">Paano Gamitin ang Polaris</string>
    <string name="user_guide_section_object_detection">Pagtukoy ng Bagay</string>
    <string name="user_guide_object_detection_bold">Itutok ang iyong camera sa iyong paligid at magsimula ng pag-scan.</string>
    <string name="user_guide_object_detection_regular">Kinikilala ng Polaris ang mga bagay at tao sa real time at nagbibigay ng audio feedback para matulungan kang maunawaan ang iyong kapaligiran.</string>
    <string name="user_guide_section_text_to_speech">Pagbasa ng Teksto</string>
    <string name="user_guide_text_to_speech_bold">Itutok ang iyong camera sa isang karatula, dokumento, o iba pang mababasang teksto at magsimula ng pag-scan.</string>
    <string name="user_guide_text_to_speech_regular">Nakikita ng Polaris ang teksto at binabasa ito nang malakas.</string>
    <string name="user_guide_section_camera_access">Access sa Camera</string>
    <string name="user_guide_camera_access_regular">Kailangan ng Polaris ng access sa camera upang makilala ang mga bagay at mabasa ang teksto.</string>
    <string name="user_guide_camera_access_bold">Payagan ang access sa camera kapag hiniling upang magamit ang mga feature na ito.</string>
    <string name="user_guide_section_audio_feedback">Audio Feedback</string>
    <string name="user_guide_audio_feedback_bold">Panatilihin ang volume ng iyong device sa komportableng antas upang malinaw na marinig ang mga tugon ng Polaris.</string>

    <!-- FAQ screen -->
    <string name="faq_title">Mga Madalas Itanong</string>
    <string name="faq_heading">Mga Madalas Itanong Tungkol sa Polaris</string>
    <string name="faq_question_1">T: Ano ang Polaris?</string>
    <string name="faq_answer_1">Ang Polaris ay isang assistive application na gumagamit ng AI, na idinisenyo upang tulungan ang mga taong may kapansanan sa paningin sa pamamagitan ng pagkilala ng bagay at pagbasa ng teksto.</string>
    <string name="faq_question_2">T: Bakit kailangan ng Polaris ang access sa camera?</string>
    <string name="faq_answer_2">Ang camera ang nagbibigay-daan sa Polaris na kumuha ng visual na impormasyong kailangan para sa pagtukoy ng bagay at pagkilala ng teksto.</string>
    <string name="faq_question_3">T: Nangangailangan ba ang Polaris ng koneksyon sa internet?</string>
    <string name="faq_answer_3">Hindi. Ang Polaris ay idinisenyo upang suportahan ang offline na paggamit para sa mga suportadong feature.</string>
    <string name="faq_question_4">T: Maaari ba akong gumamit ng voice commands?</string>
    <string name="faq_answer_4">Oo. Sinusuportahan ng Polaris ang voice commands para sa mga pangunahing function. Kinakailangan ang access sa microphone upang magamit ang voice commands.</string>

