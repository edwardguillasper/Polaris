<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="32dp"
    android:orientation="horizontal">

  <View
      android:layout_width="3dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="16dp"
      android:background="@color/polaris_menu_divider" />

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/activity_log_item_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/polaris_heading_accent"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/activity_log_item_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/polaris_menu_subitem_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/activity_log_item_timestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/polaris_menu_close"
        android:textSize="14sp" />

  </LinearLayout>

</LinearLayout>
