<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/chooser_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:clipChildren="false">

  <View
      android:id="@+id/home_blob_top"
      android:layout_width="420dp"
      android:layout_height="420dp"
      android:background="@drawable/bg_blob_home_top"
      android:translationX="-160dp"
      android:translationY="-180dp"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <View
      android:id="@+id/home_blob_bottom"
      android:layout_width="480dp"
      android:layout_height="480dp"
      android:background="@drawable/bg_blob_home_bottom"
      android:translationX="60dp"
      android:translationY="260dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <ImageView
      android:id="@+id/menu_button"
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:layout_marginStart="24dp"
      android:layout_marginTop="28dp"
      android:contentDescription="@string/menu_button_desc"
      android:src="@drawable/ic_menu_hamburger"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <ImageView
      android:id="@+id/home_logo"
      android:layout_width="72dp"
      android:layout_height="58dp"
      android:layout_marginTop="24dp"
      android:layout_marginEnd="24dp"
      android:contentDescription="@string/get_started_logo_desc"
      android:src="@drawable/polaris_logo"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <LinearLayout
      android:id="@+id/card_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">

    <FrameLayout
        android:id="@+id/card_object_detection"
        android:layout_width="204dp"
        android:layout_height="148dp"
        android:background="@drawable/bg_home_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

      <ImageView
          android:layout_width="80dp"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal|top"
          android:layout_marginTop="18dp"
          android:adjustViewBounds="true"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_card_object_detection"
          android:contentDescription="@string/chooser_title_object_detection" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|center_horizontal"
          android:layout_marginBottom="14dp"
          android:text="@string/chooser_title_object_detection"
          android:textColor="@color/polaris_home_card_text"
          android:textSize="15sp"
          android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/card_text_to_speech"
        android:layout_width="204dp"
        android:layout_height="148dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_home_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

      <ImageView
          android:layout_width="80dp"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal|top"
          android:layout_marginTop="18dp"
          android:adjustViewBounds="true"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_card_text_to_speech"
          android:contentDescription="@string/chooser_title_text_to_speech" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|center_horizontal"
          android:layout_marginBottom="14dp"
          android:text="@string/chooser_title_text_to_speech"
          android:textColor="@color/polaris_home_card_text"
          android:textSize="15sp"
          android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/card_navigation"
        android:layout_width="204dp"
        android:layout_height="148dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_home_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

      <ImageView
          android:layout_width="80dp"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal|top"
          android:layout_marginTop="18dp"
          android:adjustViewBounds="true"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_card_navigation"
          android:contentDescription="@string/chooser_title_navigation" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|center_horizontal"
          android:layout_marginBottom="14dp"
          android:text="@string/chooser_title_navigation"
          android:textColor="@color/polaris_home_card_text"
          android:textSize="15sp"
          android:textStyle="bold" />
    </FrameLayout>

  </LinearLayout>

  <ImageView
      android:id="@+id/voice_command_icon"
      android:layout_width="56dp"
      android:layout_height="56dp"
      android:layout_marginEnd="24dp"
      android:layout_marginBottom="32dp"
      android:background="@drawable/bg_voice_command_fab"
      android:clickable="true"
      android:focusable="true"
      android:elevation="6dp"
      android:padding="15dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_card_mic"
      android:contentDescription="@string/voice_command_mic_desc"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

  <!-- Hamburger menu slide-in panel -->
  <LinearLayout
      android:id="@+id/menu_drawer_root"
      android:layout_width="304dp"
      android:layout_height="match_parent"
      android:layout_gravity="start"
      android:background="@drawable/bg_screen_gradient"
      android:elevation="8dp"
      android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

      <ImageView
          android:id="@+id/menu_logo"
          android:layout_width="56dp"
          android:layout_height="44dp"
          android:layout_alignParentStart="true"
          android:layout_centerVertical="true"
          android:contentDescription="@string/get_started_logo_desc"
          android:src="@drawable/polaris_logo" />

      <ImageView
          android:id="@+id/menu_close_button"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_alignParentEnd="true"
          android:layout_centerVertical="true"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/menu_close_button_desc"
          android:padding="6dp"
          android:src="@drawable/ic_close" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/polaris_menu_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/menu_drawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/menu_item_how_you_use"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

      <TextView
          android:id="@+id/menu_item_how_you_use_text"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:textColor="@color/polaris_menu_text"
          android:textSize="19sp" />

      <ImageView
          android:id="@+id/menu_item_how_you_use_chevron"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@string/menu_section_expand_desc"
          android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_submenu_how_you_use"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_menu_submenu"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:visibility="gone">

      <TextView
          android:id="@+id/menu_subitem_activity"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_activity"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/polaris_menu_submenu_divider" />

      <TextView
          android:id="@+id/menu_subitem_notifications"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_notifications"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/polaris_menu_submenu_divider" />

      <TextView
          android:id="@+id/menu_subitem_device_permissions"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_device_permissions"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/polaris_menu_divider" />

    <LinearLayout
        android:id="@+id/menu_item_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/menu_item_help"
          android:textColor="@color/polaris_menu_text"
          android:textSize="19sp" />

      <ImageView
          android:id="@+id/menu_item_help_chevron"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@string/menu_section_expand_desc"
          android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_submenu_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_menu_submenu"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:visibility="gone">

      <TextView
          android:id="@+id/menu_subitem_user_guide"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_user_guide"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/polaris_menu_submenu_divider" />

      <TextView
          android:id="@+id/menu_subitem_faq"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_faq"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/polaris_menu_divider" />

    <LinearLayout
        android:id="@+id/menu_item_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/menu_item_account"
          android:textColor="@color/polaris_menu_text"
          android:textSize="19sp" />

      <ImageView
          android:id="@+id/menu_item_account_chevron"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@string/menu_section_expand_desc"
          android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_submenu_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_menu_submenu"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:visibility="gone">

      <TextView
          android:id="@+id/menu_subitem_manage_account"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_manage_account"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/polaris_menu_submenu_divider" />

      <TextView
          android:id="@+id/menu_subitem_log_out"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_log_out"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/polaris_menu_divider" />

    <LinearLayout
        android:id="@+id/menu_item_appearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/menu_item_appearance"
          android:textColor="@color/polaris_menu_text"
          android:textSize="19sp" />

      <ImageView
          android:id="@+id/menu_item_appearance_chevron"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@string/menu_section_expand_desc"
          android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_submenu_appearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_menu_submenu"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:visibility="gone">

      <TextView
          android:id="@+id/menu_subitem_theme_light"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_theme_light"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/polaris_menu_submenu_divider" />

      <TextView
          android:id="@+id/menu_subitem_theme_dark"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_theme_dark"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/polaris_menu_submenu_divider" />

      <TextView
          android:id="@+id/menu_subitem_theme_system"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_theme_system"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/polaris_menu_divider" />

    <LinearLayout
        android:id="@+id/menu_item_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/menu_item_language"
          android:textColor="@color/polaris_menu_text"
          android:textSize="19sp" />

      <ImageView
          android:id="@+id/menu_item_language_chevron"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@string/menu_section_expand_desc"
          android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_submenu_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_menu_submenu"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:visibility="gone">

      <TextView
          android:id="@+id/menu_subitem_language_english"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_language_english"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/polaris_menu_submenu_divider" />

      <TextView
          android:id="@+id/menu_subitem_language_tagalog"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:paddingTop="16dp"
          android:paddingBottom="16dp"
          android:text="@string/menu_subitem_language_tagalog"
          android:textColor="@color/polaris_menu_subitem_text"
          android:textSize="16sp" />

    </LinearLayout>

    </LinearLayout>

    </ScrollView>

  </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
