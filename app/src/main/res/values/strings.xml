    <!-- User guide screen -->
    <string name="user_guide_title" translatable="false">User Guide</string>
    <string name="user_guide_heading" translatable="false">How to use Polaris</string>
    <string name="user_guide_section_object_detection" translatable="false">Object Detection</string>
    <string name="user_guide_object_detection_bold" translatable="false">Point your camera toward your surroundings and start a scan.</string>
    <string name="user_guide_object_detection_regular" translatable="false">Polaris identifies objects and people in real time and provides audio feedback to help you understand your environment.</string>
    <string name="user_guide_section_text_to_speech" translatable="false">Text-to-Speech</string>
    <string name="user_guide_text_to_speech_bold" translatable="false">Point your camera toward a sign, document, or other readable text and start a scan.</string>
    <string name="user_guide_text_to_speech_regular" translatable="false">Polaris detects the text and reads it aloud.</string>
    <string name="user_guide_section_camera_access" translatable="false">Camera Access</string>
    <string name="user_guide_camera_access_regular" translatable="false">Polaris needs camera access to recognize objects and read text.</string>
    <string name="user_guide_camera_access_bold" translatable="false">Allow camera access when prompted to use these features.</string>
    <string name="user_guide_section_audio_feedback" translatable="false">Audio Feedback</string>
    <string name="user_guide_audio_feedback_bold" translatable="false">Keep your device\'s volume at a comfortable level to hear Polaris\'s responses clearly.</string>

    <!-- FAQ screen -->
    <string name="faq_title" translatable="false">Frequently Asked Questions</string>
    <string name="faq_heading" translatable="false">FAQs about Polaris</string>
    <string name="faq_question_1" translatable="false">Q: What is Polaris?</string>
    <string name="faq_answer_1" translatable="false">Polaris is an AI-based assistive application designed to help visually impaired individuals though object recognition and text-to-speech</string>
    <string name="faq_question_2" translatable="false">Q: Why does Polaris need camera access?</string>
    <string name="faq_answer_2" translatable="false">The camera allows Polaris to capture visual information needed for object detection and text recognition.</string>
    <string name="faq_question_3" translatable="false">Q: Does Polaris require an internet connection?</string>
    <string name="faq_answer_3" translatable="false">No. Polaris is designed to support offline operation for supported features.</string>
    <string name="faq_question_4" translatable="false">Q: Can I use voice commands?</string>
    <string name="faq_answer_4" translatable="false">Yes. Polaris supports voice commands for major functions. Microphone access is required to use voice commands.</string>

